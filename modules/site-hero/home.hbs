{{!< default}}

{{!-- Homepage (page 1). Overrides the core home.hbs because the feed must skip the posts the
      Featured hero already shows: the hero card plus the 3 latest others.
      That is exact when the featured post is among the 4 latest or there is none; if an older
      featured post is the card, one recent post may repeat. Keep the rest in step with core/home.hbs. --}}
<h1 class="gh-visually-hidden">{{@site.title}}</h1>

{{> "home-before"}}

<div class="gh-wrap gh-feed-wrap">
    <h2 class="gh-section-title">{{t "Latest posts"}}</h2>
    {{#if @custom.show_hero}}
        {{#match @custom.hero_style "Featured"}}
            {{> "post-feed" skip_from="5"}}
        {{else}}
            {{> "post-feed"}}
        {{/match}}
    {{else}}
        {{> "post-feed"}}
    {{/if}}
</div>

{{pagination}}

{{> "home-after"}}
