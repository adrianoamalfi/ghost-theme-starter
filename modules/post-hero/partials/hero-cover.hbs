{{!-- Cover / Slideshow hero: the photograph is the hero, the caption is small. Param: slides = how many featured
      posts with a feature image to show (1 = Cover). Slides fade into each other in modules/hero-slideshow.js;
      without JS the first one stays. --}}
{{#get "posts" filter="featured:true+feature_image:-null" limit=slides include="tags" as |slides|}}
    {{#if slides}}
    <section class="gh-cover" data-cover-slideshow aria-roledescription="carousel" aria-label="{{t "Featured photographs"}}">
        {{#foreach slides}}
            <div class="gh-cover-slide{{#if @first}} is-active{{/if}}">
                <a class="gh-cover-link" href="{{url}}">
                    <img class="gh-cover-image"
                        srcset="{{img_url feature_image size="l" format="webp"}} 1024w, {{img_url feature_image size="xl" format="webp"}} 1920w"
                        sizes="100vw" src="{{img_url feature_image size="xl" format="webp"}}"
                        {{#if feature_image_width}}width="{{feature_image_width}}" height="{{feature_image_height}}"{{else}}width="1920" height="1280"{{/if}}
                        alt="{{feature_image_alt}}"
                        {{#if @first}}fetchpriority="high"{{else}}loading="lazy"{{/if}} decoding="async">
                    <span class="gh-cover-caption">
                        <span class="gh-cover-meta">{{#primary_tag}}{{name}} · {{/primary_tag}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM YYYY"}}</time></span>
                        <span class="gh-cover-title">{{title}}</span>
                    </span>
                </a>
            </div>
        {{/foreach}}
        <div hidden data-gh-labels="hero-slideshow" data-photograph="{{t "Photograph"}}" data-pause="{{t "Pause slideshow"}}" data-play="{{t "Play slideshow"}}"></div>
    </section>
    {{else}}
        {{> "post-hero-intro"}}
    {{/if}}
{{else}}
    {{> "post-hero-intro"}}
{{/get}}
