{{!-- Title, excerpt and body of a page, for the pack's page templates. Context: a post/page.
      Param: eyebrow (already translated) shows a small label above the title. --}}
<article class="gh-article gh-article--page {{post_class}}">
    <header class="gh-article-header">
        {{> "breadcrumbs"}}
        {{#if eyebrow}}<p class="gh-eyebrow">{{eyebrow}}</p>{{/if}}
        <h1 class="gh-article-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="gh-article-excerpt">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if content}}<section class="gh-content gh-canvas">{{content}}</section>{{/if}}
</article>
