{{!< default}}

{{!-- Homepage (page 1). Overrides site-hero's home.hbs (which overrides core's): the feed must
      also leave out featured posts when the slider shows them. Keep the rest in step with
      core/home.hbs and modules/site-hero/home.hbs. --}}
<h1 class="gh-visually-hidden">{{@site.title}}</h1>

{{> "home-before"}}

<div class="gh-wrap gh-feed-wrap">
    <h2 class="gh-section-title">{{t "Latest posts"}}</h2>
    {{#if @custom.show_hero}}
        {{#match @custom.hero_style "Featured"}}
            {{> "post-feed" skip_from="5" skip_featured=@custom.show_featured_slider}}
        {{else}}
            {{> "post-feed" skip_featured=@custom.show_featured_slider}}
        {{/match}}
    {{else}}
        {{> "post-feed" skip_featured=@custom.show_featured_slider}}
    {{/if}}
</div>

{{pagination}}

{{> "home-after"}}
