{{!< default}}

{{!-- Homepage = index plus the home-before slot. Themes put their hero in
      partials/home-before.hbs; home.hbs itself stays untouched. --}}
<h1 class="gh-visually-hidden">{{@site.title}}</h1>

{{> "home-before"}}

<div class="gh-wrap gh-feed-wrap">
    <h2 class="gh-section-title">{{t "Latest posts"}}</h2>
    {{> "post-feed"}}
</div>

{{pagination}}

{{> "home-after"}}
