{{!-- Rendered by Ghost's {{recommendations}} helper. Keeps the markup under theme control. --}}
{{#if recommendations}}
<section class="gh-recs" aria-labelledby="gh-recs-title">
    <h2 class="gh-recs-title" id="gh-recs-title">{{t "Recommended sites"}}</h2>
    <ul class="gh-recs-list">
        {{#foreach recommendations as |rec|}}
            <li>
                <a class="gh-rec" href="{{rec.url}}" data-recommendation="{{rec.id}}" target="_blank" rel="noopener">
                    {{#if rec.favicon}}<img class="gh-rec-icon" src="{{rec.favicon}}" alt="" width="24" height="24" loading="lazy" decoding="async">{{/if}}
                    <span class="gh-rec-body">
                        <span class="gh-rec-title">{{rec.title}}</span>
                        <span class="gh-rec-url">{{readable_url rec.url}}</span>
                        <span class="gh-visually-hidden">{{t "Opens in a new tab"}}</span>
                        {{#if rec.description}}<span class="gh-rec-desc">{{rec.description}}</span>{{/if}}
                    </span>
                </a>
            </li>
        {{/foreach}}
    </ul>
</section>
{{/if}}
