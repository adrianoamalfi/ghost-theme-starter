{{#> header-layout}}
<header id="gh-header" class="gh-header">
    <div class="gh-header-inner gh-wrap">
        <a class="gh-header-logo" href="{{@site.url}}">
            {{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}" decoding="async">{{else}}{{@site.title}}{{/if}}
        </a>

        <nav class="gh-nav" id="gh-nav" aria-label="{{t "Main navigation"}}">
            {{navigation}}
        </nav>

        <div class="gh-header-actions">
            {{> "header-actions"}}

            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <a class="gh-button gh-header-cta" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                {{else}}
                    <a class="gh-button gh-button--ghost gh-header-cta" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                {{/unless}}
            {{/if}}

            <button class="gh-icon-button" type="button" data-ghost-search aria-label="{{t "Search"}}">{{> "icons/search"}}</button>
            <kbd class="gh-search-kbd" aria-hidden="true">⌘K</kbd>

            {{#> header-scheme}}{{> "scheme-toggle"}}{{/header-scheme}}

            <button class="gh-icon-button gh-burger" type="button" id="gh-burger" aria-label="{{t "Open menu"}}"
                data-label-close="{{t "Close menu"}}" aria-expanded="false" aria-controls="gh-nav">{{> "icons/menu"}}</button>
        </div>
    </div>
</header>
{{/header-layout}}
