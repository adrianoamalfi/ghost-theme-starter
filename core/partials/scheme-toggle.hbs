{{!-- Default one-button colour scheme cycle (system > light > dark). Wired by core/scheme.js. --}}
<button class="gh-icon-button" type="button" id="gh-scheme-toggle" aria-label="{{t "Change color scheme"}}"
    data-label-light="{{t "Switch to dark mode"}}" data-label-dark="{{t "Switch to system mode"}}" data-label-system="{{t "Switch to light mode"}}">
    {{> "icons/sun"}}{{> "icons/moon"}}
</button>
