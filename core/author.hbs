{{!< default}}

{{#author}}
<header class="gh-wrap gh-archive-header">
    {{> "breadcrumbs"}}
    {{#if profile_image}}
        <img class="gh-avatar gh-avatar--lg" src="{{img_url profile_image size="s" format="webp"}}" alt="" width="96" height="96" decoding="async">
    {{/if}}
    <p class="gh-eyebrow">{{t "Author"}}</p>
    <h1 class="gh-archive-title">{{name}}</h1>
    {{#if bio}}<p class="gh-archive-text">{{bio}}</p>{{/if}}
    <p class="gh-archive-count">
        {{#if location}}<span>{{location}}</span> · {{/if}}
        {{#if website}}<a href="{{website}}" rel="me noopener">{{t "Website"}}</a> · {{/if}}
        <span>{{plural ../pagination.total empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</span>
    </p>
</header>
{{/author}}

<div class="gh-wrap gh-feed-wrap">
    {{> "post-feed"}}
</div>

{{pagination}}
